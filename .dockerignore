# Dependencies and build output (rebuilt inside the image)
node_modules
dist
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
!src/types/*.d.ts
src/generated

# Secrets: never bake into the image; pass at runtime with --env-file
.env*
*.pem
*.key

# Not needed at runtime
.git
.gitignore
tests
*.md
Dockerfile
.dockerignore
.claude
.vscode
npm-debug.log*
